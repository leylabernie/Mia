<%- include('partials/header') %>
<main class="min-h-screen">
<section class="relative py-24 bg-gradient-to-b from-lux-rose-white to-lux-white dark:bg-gray-900/50">
<div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
<div class="max-w-4xl mx-auto text-center px-4 relative z-10">
<span class="block text-lux-blue-grey uppercase tracking-[0.3em] text-xs font-bold mb-6">Concierge Services</span>
<h1 class="font-display text-6xl md:text-7xl text-gray-800 dark:text-white font-light mb-8 leading-tight">
                    Get in Touch
                </h1>
<p class="text-gray-500 dark:text-gray-400 text-lg font-light tracking-wide max-w-2xl mx-auto leading-relaxed">
                    We are dedicated to providing you with an exceptional experience. Whether you need styling advice, assistance with an order, or wish to book an appointment, our team is at your service.
                </p>
</div>
</section>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
<div class="lg:col-span-5 space-y-16">
<div>
<h2 class="font-display text-4xl text-gray-800 dark:text-white font-light mb-8">Visit Our Boutique</h2>
<div class="space-y-8">
<div class="flex items-start group">
<div class="w-12 h-12 rounded-full bg-lux-cream/40 flex items-center justify-center mr-6 text-lux-blue-grey group-hover:bg-lux-salmon group-hover:text-white transition-colors duration-300">
<span class="material-symbols-outlined text-xl">storefront</span>
</div>
<div>
<h3 class="text-xs uppercase tracking-widest font-bold text-gray-400 mb-2">Flagship Store</h3>
<p class="text-gray-600 dark:text-gray-300 font-light leading-relaxed">
                                        24, Khar Linking Road,<br/>
                                        Khar West, Mumbai,<br/>
                                        Maharashtra 400052
                                    </p>
</div>
</div>
<div class="flex items-start group">
<div class="w-12 h-12 rounded-full bg-lux-cream/40 flex items-center justify-center mr-6 text-lux-blue-grey group-hover:bg-lux-salmon group-hover:text-white transition-colors duration-300">
<span class="material-symbols-outlined text-xl">call</span>
</div>
<div>
<h3 class="text-xs uppercase tracking-widest font-bold text-gray-400 mb-2">Phone Support</h3>
<p class="text-gray-600 dark:text-gray-300 font-light text-lg mb-1 hover:text-lux-salmon cursor-pointer transition-colors">+91-8291990059</p>
<p class="text-xs text-gray-400 font-light">Mon - Sat, 10:00 AM - 8:00 PM IST</p>
</div>
</div>
<div class="flex items-start group">
<div class="w-12 h-12 rounded-full bg-lux-cream/40 flex items-center justify-center mr-6 text-lux-blue-grey group-hover:bg-lux-salmon group-hover:text-white transition-colors duration-300">
<span class="material-symbols-outlined text-xl">mail</span>
</div>
<div>
<h3 class="text-xs uppercase tracking-widest font-bold text-gray-400 mb-2">Email Us</h3>
<p class="text-gray-600 dark:text-gray-300 font-light mb-1 hover:text-lux-salmon cursor-pointer transition-colors">concierge@aza-fashions.com</p>
<p class="text-gray-600 dark:text-gray-300 font-light hover:text-lux-salmon cursor-pointer transition-colors">press@aza-fashions.com</p>
</div>
</div>
</div>
</div>
<div class="relative w-full h-80 bg-lux-sage/10 rounded-sm overflow-hidden border border-lux-pale-pink p-2">
<div class="w-full h-full grayscale hover:grayscale-0 transition-all duration-700 opacity-80 hover:opacity-100">
<iframe allowfullscreen="" height="100%" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3770.976378453416!2d72.83354397520496!3d19.06476628213753!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7c91130392c07%3A0x3c47bf391c8de931!2sKhar%20Linking%20Rd%2C%20Khar%20West%2C%20Mumbai%2C%20Maharashtra!5e0!3m2!1sen!2sin!4v1716300000000!5m2!1sen!2sin" style="border:0;" width="100%"></iframe>
</div>
</div>
</div>
<div class="lg:col-span-7">
<div class="bg-lux-rose-white/40 dark:bg-gray-800/40 p-10 md:p-14 border border-lux-pale-pink dark:border-gray-700 rounded-sm shadow-sm relative overflow-hidden">
<div class="absolute -top-20 -right-20 w-64 h-64 bg-lux-cream/20 rounded-full blur-3xl pointer-events-none"></div>
<h2 class="font-display text-4xl text-gray-800 dark:text-white font-light mb-2 relative z-10">Send an Inquiry</h2>
<p class="text-gray-500 font-light mb-12 text-sm relative z-10">Please fill out the form below and a member of our team will contact you shortly.</p>
<form class="space-y-10 relative z-10">
<div class="grid grid-cols-1 md:grid-cols-2 gap-10">
<div class="relative">
<input class="peer block w-full appearance-none border-0 border-b border-lux-sage bg-transparent px-0 py-2.5 text-sm text-gray-900 focus:border-lux-salmon focus:outline-none focus:ring-0 dark:text-white dark:focus:border-lux-salmon" id="first_name" placeholder=" " type="text"/>
<label class="absolute top-3 -z-10 origin-[0] -translate-y-6 scale-75 transform text-xs uppercase tracking-widest text-gray-500 duration-300 peer-placeholder-shown:translate-y-0 peer-placeholder-shown:scale-100 peer-focus:left-0 peer-focus:-translate-y-6 peer-focus:scale-75 peer-focus:text-lux-salmon dark:text-gray-400 peer-focus:dark:text-lux-salmon" for="first_name">First Name</label>
</div>
<div class="relative">
<input class="peer block w-full appearance-none border-0 border-b border-lux-sage bg-transparent px-0 py-2.5 text-sm text-gray-900 focus:border-lux-salmon focus:outline-none focus:ring-0 dark:text-white dark:focus:border-lux-salmon" id="last_name" placeholder=" " type="text"/>
<label class="absolute top-3 -z-10 origin-[0] -translate-y-6 scale-75 transform text-xs uppercase tracking-widest text-gray-500 duration-300 peer-placeholder-shown:translate-y-0 peer-placeholder-shown:scale-100 peer-focus:left-0 peer-focus:-translate-y-6 peer-focus:scale-75 peer-focus:text-lux-salmon dark:text-gray-400 peer-focus:dark:text-lux-salmon" for="last_name">Last Name</label>
</div>
</div>
<div class="relative">
<input class="peer block w-full appearance-none border-0 border-b border-lux-sage bg-transparent px-0 py-2.5 text-sm text-gray-900 focus:border-lux-salmon focus:outline-none focus:ring-0 dark:text-white dark:focus:border-lux-salmon" id="email" placeholder=" " type="email"/>
<label class="absolute top-3 -z-10 origin-[0] -translate-y-6 scale-75 transform text-xs uppercase tracking-widest text-gray-500 duration-300 peer-placeholder-shown:translate-y-0 peer-placeholder-shown:scale-100 peer-focus:left-0 peer-focus:-translate-y-6 peer-focus:scale-75 peer-focus:text-lux-salmon dark:text-gray-400 peer-focus:dark:text-lux-salmon" for="email">Email Address</label>
</div>
<div class="relative">
<select class="peer block w-full appearance-none border-0 border-b border-lux-sage bg-transparent px-0 py-2.5 text-sm text-gray-900 focus:border-lux-salmon focus:outline-none focus:ring-0 dark:text-white dark:focus:border-lux-salmon" id="subject">
<option>Styling Consultation</option>
<option>Order Inquiry</option>
<option>Bespoke Request</option>
<option>Other</option>
</select>
<label class="absolute top-3 -z-10 origin-[0] -translate-y-6 scale-75 transform text-xs uppercase tracking-widest text-gray-500 duration-300 peer-focus:left-0 peer-focus:-translate-y-6 peer-focus:scale-75 peer-focus:text-lux-salmon dark:text-gray-400 peer-focus:dark:text-lux-salmon" for="subject">Subject</label>
</div>
<div class="relative">
<textarea class="peer block w-full appearance-none border-0 border-b border-lux-sage bg-transparent px-0 py-2.5 text-sm text-gray-900 focus:border-lux-salmon focus:outline-none focus:ring-0 dark:text-white dark:focus:border-lux-salmon" id="message" placeholder=" " rows="4"></textarea>
<label class="absolute top-3 -z-10 origin-[0] -translate-y-6 scale-75 transform text-xs uppercase tracking-widest text-gray-500 duration-300 peer-placeholder-shown:translate-y-0 peer-placeholder-shown:scale-100 peer-focus:left-0 peer-focus:-translate-y-6 peer-focus:scale-75 peer-focus:text-lux-salmon dark:text-gray-400 peer-focus:dark:text-lux-salmon" for="message">Your Message</label>
</div>
<div class="pt-6">
<button class="group relative w-full md:w-auto inline-flex items-center justify-center px-12 py-4 overflow-hidden font-medium text-white transition duration-300 ease-out bg-lux-blue-grey rounded-sm shadow-md hover:shadow-lg" type="button">
<span class="absolute inset-0 flex items-center justify-center w-full h-full text-white duration-300 -translate-x-full bg-lux-salmon group-hover:translate-x-0 ease">
<span class="material-symbols-outlined ml-2">send</span>
</span>
<span class="absolute flex items-center justify-center w-full h-full text-white transition-all duration-300 transform group-hover:translate-x-full ease uppercase tracking-widest text-xs font-bold">Submit Inquiry</span>
<span class="relative invisible uppercase tracking-widest text-xs font-bold">Submit Inquiry</span>
</button>
</div>
</form>
</div>
</div>
</div>
</section>
</main>
<%- include('partials/footer') %>