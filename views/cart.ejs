<%- include('partials/header') %>
<main class="flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full relative">
<div class="absolute top-0 right-0 -z-10 opacity-10 pointer-events-none hidden lg:block transform translate-x-1/4 -translate-y-12">
<svg height="600" viewBox="0 0 200 200" width="600" xmlns="http://www.w3.org/2000/svg">
<path d="M45.7,-76.3C58.9,-69.3,69.1,-58.3,77.3,-46.3C85.5,-34.3,91.7,-21.3,92.5,-8.1C93.3,5.1,88.7,18.5,81.4,30.3C74.1,42.1,64.1,52.3,52.8,60.8C41.5,69.3,28.9,76.1,15.6,78.9C2.3,81.7,-11.7,80.5,-24.5,76.1C-37.3,71.7,-48.9,64.1,-58.5,54.3C-68.1,44.5,-75.7,32.5,-80.1,19.3C-84.5,6.1,-85.7,-8.3,-81.1,-21.2C-76.5,-34.1,-66.1,-45.5,-54.3,-53.4C-42.5,-61.3,-29.3,-65.7,-16.5,-68.2C-3.7,-70.7,8.7,-71.3,21.5,-70.6" fill="#F5AFAF" transform="translate(100 100)"></path>
</svg>
</div>
<div class="mb-12 text-center relative">
<span class="text-primary text-lg font-serif italic mb-2 block">The Boutique Collection</span>
<h1 class="text-5xl md:text-6xl font-serif text-text mb-4 font-light">Your Shopping Cart</h1>
<div class="h-1 w-24 bg-gradient-to-r from-secondary to-border mx-auto rounded-full"></div>
</div>
<div class="lg:grid lg:grid-cols-12 lg:gap-16 items-start">
<div class="lg:col-span-8">
<div class="flex justify-between items-end border-b border-border pb-4 mb-8">
<h2 class="text-2xl font-serif text-text-muted font-light">Selected Items <span id="cart-item-count" class="text-lg text-primary ml-2">(0)</span></h2>
</div>
<div id="cart-items" class="space-y-6">
</div>
<div class="mt-10">
<a class="inline-flex items-center text-primary hover:text-primary-dark font-medium transition-all group" href="products.html">
<span class="material-icons text-lg mr-2 transform rotate-180 group-hover:-translate-x-1 transition-transform">arrow_right_alt</span>
<span class="border-b border-transparent group-hover:border-primary-dark uppercase tracking-wider text-sm">Continue Shopping</span>
</a>
</div>
</div>
<div class="lg:col-span-4 mt-10 lg:mt-0">
<div class="bg-surface-sidebar p-8 rounded-xl border border-border shadow-soft sticky top-28">
<h2 class="text-3xl font-serif text-text mb-8 text-center">Order Summary</h2>
<div class="space-y-5 text-sm">
<div class="flex justify-between items-center text-text-muted">
<span class="font-light">Subtotal</span>
<span id="subtotal" class="font-medium text-text">₹0</span>
</div>
<div class="flex justify-between items-center text-text-muted">
<span class="font-light">Estimated Shipping</span>
<span class="font-medium text-text">₹500</span>
</div>
<div class="flex justify-between items-center text-text-muted">
<span class="font-light">Estimated Tax</span>
<span id="tax" class="font-medium text-text">₹0</span>
</div>
</div>
<div class="border-t border-secondary/20 my-8 pt-6">
<label class="block text-xs uppercase tracking-widest text-text-muted mb-3" for="discount-code">Discount Code</label>
<div class="flex gap-2">
<input class="flex-1 bg-surface-card border border-border rounded-lg px-4 py-2.5 text-sm focus:ring-1 focus:ring-primary focus:border-primary placeholder-secondary" id="discount-code" placeholder="Enter promo code" type="text"/>
<button class="bg-secondary hover:bg-primary text-white px-5 py-2 rounded-lg text-sm font-medium transition-colors uppercase tracking-wide">Apply</button>
</div>
</div>
<div class="border-t border-secondary/20 pt-6 mb-8">
<div class="flex justify-between items-end">
<span class="text-xl font-serif text-text">Total</span>
<div class="text-right">
<span id="total" class="text-3xl font-serif font-bold text-primary block">₹0</span>
<p class="text-[10px] text-text-muted uppercase tracking-wider mt-1">Including GST</p>
</div>
</div>
</div>
<a href="checkout.html" class="w-full bg-primary hover:bg-primary-dark text-white py-4 px-4 rounded-lg text-sm font-bold tracking-widest uppercase transition-all shadow-md hover:shadow-xl transform hover:-translate-y-0.5 text-center">
                    Proceed to Checkout
                </a>
<div class="flex justify-center items-center gap-6 mt-8 opacity-50 grayscale transition-opacity hover:opacity-80">
