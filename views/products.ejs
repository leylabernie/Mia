<label class="flex items-center space-x-3 cursor-pointer group">
<input class="form-checkbox h-4 w-4 text-brand-sage border-neutral-sage rounded-sm focus:ring-brand-sage focus:ring-offset-0 bg-page-bg transition duration-150 ease-in-out" type="checkbox"/>
<span class="text-sm font-light text-text-secondary group-hover:text-brand-sage transition-colors">Banarasi Silk</span>
</label>
<label class="flex items-center space-x-3 cursor-pointer group">
