</div>
<span class="text-neutral-sage">-</span>
<div class="flex items-center bg-white px-2 py-1 border border-neutral-sage/50 rounded-sm">
<span class="text-xs text-text-secondary mr-1 currency-symbol">₹</span>
<input class="w-full text-xs text-center border-none p-0 focus:ring-0 text-text-primary price-input" data-base-value="25000" type="text" value="25,000"/>
