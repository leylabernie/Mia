<%- include('partials/header') %>
</div>
</div>
<!-- Main Content Wrapper -->
<main class="flex flex-col items-center justify-center w-full pb-20">
<!-- Hero Section -->
<div class="w-full relative bg-cover bg-center bg-no-repeat min-h-[320px] lg:min-h-[400px] flex items-center justify-center" data-alt="Soft focused elegant Indian fabric textures in gold and cream" style='background-image: linear-gradient(rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.5) 100%), url("https://lh3.googleusercontent.com/aida-public/AB6AXuAmeFruByRmNtdx4ZB5woD5TchymZYDsSSap_1iTsFIWNkub8pr_AVsqX2BObUSikGofdHUQszUaZWPtpdP9i6XrpEUEzVaQgfH5CB5GMvl6TJvtMsBtv4Xdt1fDJTpYzxLaIwj8zcXhq5Nq3Jt6ZL6f0ruBQ0RC9mYvzpHRk17LjePAF1xN5435QeOWWKDXVAwj5rsH1tPCtTGLLZ9euzgliYl4k_fILE3e8AceoXMBG451DNUSSCQnIRHcGvrNSiBLd3Qwl60SV4");'>
<div class="text-center px-4 max-w-2xl animate-fade-in-up">
<span class="text-primary font-bold tracking-widest text-xs uppercase mb-2 block">Gifting Made Special</span>
<h1 class="text-white text-4xl lg:text-5xl font-display font-black leading-tight tracking-[-0.033em] mb-4">
                    The Gift of Heritage
                </h1>
<p class="text-white/90 text-sm lg:text-lg font-normal leading-relaxed max-w-lg mx-auto">
                    Share the love of exquisite craftsmanship with a digital gift card, delivered instantly to their inbox.
                </p>
</div>
</div>
<div class="max-w-[1280px] w-full px-4 lg:px-10 py-12 lg:py-20">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
<!-- Left Column: Card Preview (Sticky on Desktop) -->
<div class="lg:col-span-5 order-1 lg:order-1">
<div class="sticky top-24 flex flex-col gap-6">
<div class="relative w-full aspect-[1.58/1] rounded-2xl overflow-hidden shadow-2xl shadow-[#e6b24c]/10 group transition-transform duration-500 hover:scale-[1.01]">
<!-- Card Background Image -->
<div class="absolute inset-0 bg-cover bg-center" data-alt="Luxurious golden mandala pattern background for gift card" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBeLNfR9xqOysM-6J7qeh_LGm2hKucaVxO63OoHGM6ozK0zCNVKlulhs9K_zsObj_xeCUdxQuCyNTXCJ--9jnrAYGvivLb78rrbo3npBtJzhLLWRkYCQ0fQu53ImJ45eocaQPlnGOJRl0MQyUiQRLMbcAw_lItW8Aeae5mvsgMoDMLxbNDnx1Vqx0I_jyfqZmZm7bnBVUlLWSBS_0HlU7rvppDl87BwNuhaGAP9JzSLWIgkaM23Bb0VUOw8H-adieFxgKuNLN55b2WA");'></div>
<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30"></div>
<!-- Card Content -->
<div class="absolute inset-0 p-6 flex flex-col justify-between text-white">
<div class="flex justify-between items-start">
<span class="font-bold text-lg tracking-wider opacity-90">ETHNIC ELEGANCE</span>
<span class="font-display font-medium text-right text-sm opacity-80">Gift Card</span>
</div>
<div class="flex flex-col gap-1">
<div class="text-3xl font-bold tracking-tight text-primary">
                                        ₹<span id="preview-amount">5,000</span>
</div>
<p class="text-sm text-white/80 line-clamp-2 italic font-light mt-2 min-h-[2.5em]" id="preview-message">
                                        "Wishing you grace and beauty on your special day."
                                    </p>
</div>
</div>
</div>
<div class="text-center lg:text-left space-y-2 px-2">
<h3 class="text-lg font-bold text-text-main">Instant Delivery</h3>
<p class="text-sm text-text-muted">Gift cards are delivered by email and contain instructions to redeem them at checkout. Our gift cards have no additional processing fees.</p>
</div>
</div>
</div>
<!-- Right Column: Form -->
<div class="lg:col-span-7 order-2 lg:order-2 flex flex-col gap-10">
<!-- Step 1: Amount -->
<section>
<h3 class="text-text-main tracking-tight text-2xl font-bold leading-tight mb-6 flex items-center gap-3">
<span class="flex items-center justify-center size-8 rounded-full bg-primary/20 text-primary text-sm font-bold">1</span>
                            Select Amount
                        </h3>
<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-4">
<button class="bg-surface hover:bg-primary/10 hover:border-primary text-text-main font-bold py-4 rounded-xl border-2 border-transparent transition-all duration-200 group">
                                ₹1,000
                            </button>
<button class="bg-surface hover:bg-primary/10 hover:border-primary text-text-main font-bold py-4 rounded-xl border-2 border-transparent transition-all duration-200 group">
                                ₹2,500
                            </button>
<button class="bg-primary text-white shadow-lg shadow-primary/30 font-bold py-4 rounded-xl border-2 border-primary transition-all duration-200 transform scale-[1.02]">
                                ₹5,000
                            </button>
<button class="bg-surface hover:bg-primary/10 hover:border-primary text-text-main font-bold py-4 rounded-xl border-2 border-transparent transition-all duration-200 group">
                                ₹10,000
                            </button>
<button class="bg-surface hover:bg-primary/10 hover:border-primary text-text-main font-bold py-4 rounded-xl border-2 border-transparent transition-all duration-200 group">
                                ₹25,000
                            </button>
<!-- Custom Amount Input -->
<div class="relative flex items-center">
<span class="absolute left-4 text-text-muted font-bold">₹</span>
<input class="w-full bg-white border-2 border-surface focus:border-primary focus:ring-0 rounded-xl py-4 pl-8 pr-4 font-bold text-text-main placeholder:text-text-muted/50 transition-colors appearance-none" placeholder="Other" type="number"/>
</div>
</div>
</section>
<!-- Step 2: Details -->
<section>
<h3 class="text-text-main tracking-tight text-2xl font-bold leading-tight mb-6 flex items-center gap-3">
<span class="flex items-center justify-center size-8 rounded-full bg-primary/20 text-primary text-sm font-bold">2</span>
                            Personalize
                        </h3>
<div class="space-y-6">
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="flex flex-col gap-2">
<label class="text-sm font-semibold text-text-main ml-1">Recipient's Name</label>
<input class="w-full bg-white border border-[#e6dcc5] focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-3 px-4 text-text-main placeholder:text-text-muted/50 transition-colors" placeholder="e.g. Priya Sharma" type="text"/>
</div>
<div class="flex flex-col gap-2">
<label class="text-sm font-semibold text-text-main ml-1">Recipient's Email</label>
<input class="w-full bg-white border border-[#e6dcc5] focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-3 px-4 text-text-main placeholder:text-text-muted/50 transition-colors" placeholder="priya@example.com" type="email"/>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="flex flex-col gap-2">
<label class="text-sm font-semibold text-text-main ml-1">Sender's Name</label>
<input class="w-full bg-white border border-[#e6dcc5] focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-3 px-4 text-text-main placeholder:text-text-muted/50 transition-colors" placeholder="Your Name" type="text"/>
</div>
<div class="flex flex-col gap-2">
<label class="text-sm font-semibold text-text-main ml-1">Delivery Date</label>
<div class="relative">
<input class="w-full bg-white border border-[#e6dcc5] focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-3 px-4 text-text-main placeholder:text-text-muted/50 transition-colors" type="date"/>
</div>
</div>
</div>
<div class="flex flex-col gap-2">
<label class="text-sm font-semibold text-text-main ml-1">Personal Message</label>
<textarea class="w-full bg-white border border-[#e6dcc5] focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-3 px-4 text-text-main placeholder:text-text-muted/50 transition-colors resize-none" placeholder="Write a warm message..." rows="4"></textarea>
<span class="text-xs text-text-muted text-right">0/200 characters</span>
</div>
</div>
</section>
<!-- Divider -->
<div class="h-px w-full bg-[#e6dcc5]/50"></div>
<!-- Checkout Section -->
<div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-white p-6 rounded-2xl border border-[#e6dcc5]/50 shadow-sm">
<div class="flex flex-col gap-1">
<span class="text-text-muted text-sm font-medium">Total Payable Amount</span>
<span class="text-3xl font-black text-text-main tracking-tight">₹5,000</span>
</div>
<button class="w-full md:w-auto min-w-[240px] bg-primary hover:bg-[#d4a03c] text-white font-bold text-lg py-4 px-8 rounded-xl shadow-lg shadow-primary/20 transition-all flex items-center justify-center gap-3">
<span class="material-symbols-outlined">shopping_bag</span>
                            Add to Bag
                        </button>
</div>
</div>
</div>
</div>
<!-- How It Works Section -->
<div class="w-full bg-white py-16 border-t border-[#f3efe8]">
<div class="max-w-[1280px] mx-auto px-4 lg:px-10">
<div class="text-center mb-12">
<h2 class="text-2xl font-bold text-text-main mb-2">How to Redeem</h2>
<div class="h-1 w-16 bg-primary mx-auto rounded-full"></div>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
<div class="flex flex-col items-center gap-4 p-6 rounded-2xl bg-surface/30">
<div class="size-16 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
<span class="material-symbols-outlined text-3xl">mail</span>
</div>
<h4 class="text-lg font-bold text-text-main">1. Receive via Email</h4>
<p class="text-sm text-text-muted leading-relaxed">The recipient receives the digital gift card with a unique code directly in their inbox instantly or on a chosen date.</p>
</div>
<div class="flex flex-col items-center gap-4 p-6 rounded-2xl bg-surface/30">
<div class="size-16 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
<span class="material-symbols-outlined text-3xl">checkroom</span>
</div>
<h4 class="text-lg font-bold text-text-main">2. Shop Favorites</h4>
<p class="text-sm text-text-muted leading-relaxed">Browse our collection of Lehengas, Sarees, and more. Add desired items to the cart as usual.</p>
</div>
<div class="flex flex-col items-center gap-4 p-6 rounded-2xl bg-surface/30">
<div class="size-16 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2">
<span class="material-symbols-outlined text-3xl">loyalty</span>
</div>
<h4 class="text-lg font-bold text-text-main">3. Apply Code</h4>
<p class="text-sm text-text-muted leading-relaxed">Enter the unique gift card code at checkout. The value will be deducted from the total amount.</p>
</div>
</div>
</div>
</div>
</main>
<!-- Footer Simplified -->
<%- include('partials/footer') %>