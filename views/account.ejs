                <input type="text" id="address-city" placeholder="City" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
                <input type="text" id="address-zip" placeholder="ZIP Code" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
                <input type="text" id="address-country" placeholder="Country" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
            </div>
            <div class="mt-6 flex justify-end">
                <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg text-sm font-medium">Save Address</button>
            </div>
        </form>
    </div>
</section>
