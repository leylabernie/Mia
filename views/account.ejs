            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <input type="text" id="address-name" placeholder="Name (e.g., Home, Office)" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
