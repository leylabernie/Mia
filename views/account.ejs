</tbody>
</table>
</div>
</div>
</section>
<section id="addresses">
    <div class="flex justify-between items-center mb-6">
        <h3 class="text-2xl font-display text-gray-900 dark:text-white">Saved Addresses</h3>
        <button id="show-add-address-form" class="bg-white dark:bg-white text-primary border border-primary hover:bg-primary hover:text-white px-5 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-widest transition-all flex items-center shadow-sm">
            <span class="material-icons-outlined text-sm mr-2">add</span> Add New
        </button>
    </div>
    <div id="address-list" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Addresses will be dynamically inserted here -->
    </div>
    <div id="add-address-form-div" class="hidden mt-6">
        <form id="add-address-form" class="bg-surface-light dark:bg-surface-dark p-8 rounded-xl border border-pastel-sage dark:border-border-dark luxury-shadow">
