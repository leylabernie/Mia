<div class="flex-1 space-y-12">
<div id="register-form-div" class="hidden">
    <section class="bg-surface-light dark:bg-surface-dark rounded-xl luxury-shadow p-8 border border-pastel-sage/50 dark:border-border-dark relative overflow-hidden">
        <h3 class="text-2xl font-display text-gray-900 dark:text-white">Register</h3>
        <form id="register-form" class="mt-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Username</label>
                    <input id="username" type="text" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
                </div>
                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Email Address</label>
                    <input id="email" type="email" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
                </div>
                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Password</label>
                    <input id="password" type="password" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
                </div>
            </div>
            <div class="mt-10 flex justify-end">
                <button type="submit" class="bg-pastel-blue hover:bg-opacity-90 text-white px-10 py-3 rounded-lg text-sm font-medium tracking-wide transition-all shadow-lg shadow-pastel-blue/20">
                    Register
                </button>
            </div>
        </form>
        <p class="mt-4 text-sm text-text-sub-light">Already have an account? <button id="show-login" class="text-primary hover:underline">Login</button></p>
    </section>
</div>
<div id="login-form-div">
    <section class="bg-surface-light dark:bg-surface-dark rounded-xl luxury-shadow p-8 border border-pastel-sage/50 dark:border-border-dark relative overflow-hidden">
        <h3 class="text-2xl font-display text-gray-900 dark:text-white">Login</h3>
        <form id="login-form" class="mt-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Email Address</label>
                    <input id="login-email" type="email" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
                </div>
                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Password</label>
                    <input id="login-password" type="password" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" required />
                </div>
            </div>
            <div class="mt-10 flex justify-end">
                <button type="submit" class="bg-pastel-blue hover:bg-opacity-90 text-white px-10 py-3 rounded-lg text-sm font-medium tracking-wide transition-all shadow-lg shadow-pastel-blue/20">
                    Login
                </button>
            </div>
        </form>
        <p class="mt-4 text-sm text-text-sub-light">Don't have an account? <button id="show-register" class="text-primary hover:underline">Register</button></p>
    </section>
</div>
<div id="account-details-div" class="hidden">
    <section class="bg-surface-light dark:bg-surface-dark rounded-xl luxury-shadow p-8 border border-pastel-sage/50 dark:border-border-dark relative overflow-hidden" id="personal">
        <div class="absolute top-0 left-0 w-1.5 h-full bg-pastel-blue"></div>
        <div class="flex justify-between items-end mb-8 border-b border-pastel-mist dark:border-border-dark pb-4">
            <div>
                <h3 class="text-2xl font-display text-gray-900 dark:text-white">Personal Details</h3>
                <p class="text-sm text-text-sub-light dark:text-gray-400 mt-2 font-light">Update your profile information and preferences.</p>
            </div>
            <button class="text-xs font-semibold uppercase tracking-widest text-primary hover:text-secondary transition-colors border-b border-transparent hover:border-secondary pb-0.5">Edit Details</button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-2">
                <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Full Name</label>
                <input id="username-display" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" disabled="" type="text" value="Anjali Sharma"/>
            </div>
            <div class="space-y-2">
                <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Email Address</label>
                <input id="email-display" class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" disabled="" type="email" value="anjali.sharma@email.com"/>
            </div>
            <div class="space-y-2">
                <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Phone Number</label>
                <input class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" disabled="" type="tel" value="+91 98765 43210"/>
            </div>
            <div class="space-y-2">
                <label class="block text-xs font-semibold text-primary dark:text-gray-400 uppercase tracking-widest">Date of Birth</label>
                <div class="relative">
                    <input class="w-full bg-pastel-snow dark:bg-gray-800 border-pastel-sage dark:border-gray-700 rounded-lg px-4 py-3 text-gray-900 dark:text-white focus:ring-0 focus:border-secondary luxury-input" placeholder="DD/MM/YYYY" type="text"/>
                    <span class="material-icons-outlined absolute right-3 top-3 text-pastel-sage">calendar_today</span>
                </div>
            </div>
        </div>
        <div class="mt-10 flex justify-end">
            <button class="bg-pastel-blue hover:bg-opacity-90 text-white px-10 py-3 rounded-lg text-sm font-medium tracking-wide transition-all shadow-lg shadow-pastel-blue/20">
                Save Changes
            </button>
        </div>
    </section>
</div>
<section id="orders">
<div class="flex justify-between items-center mb-6">
<h3 class="text-2xl font-display text-gray-900 dark:text-white">Recent Orders</h3>
<a class="text-xs font-semibold uppercase tracking-widest text-primary hover:text-secondary transition-colors" href="#">View All Orders</a>
</div>
<div class="bg-surface-light dark:bg-surface-dark rounded-xl luxury-shadow overflow-hidden border border-pastel-sage/50 dark:border-border-dark">
<div class="overflow-x-auto">
<table class="w-full text-left">
<thead class="bg-pastel-mist dark:bg-gray-800/50 text-xs uppercase text-text-sub-light dark:text-gray-400 font-semibold tracking-widest">
<tr>
<th class="px-6 py-5">Order #</th>
<th class="px-6 py-5">Status</th>
<th class="px-6 py-5">Date</th>
<th class="px-6 py-5 text-right">Action</th>
</tr>
</thead>
