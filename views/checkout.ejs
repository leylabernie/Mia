<%- include('partials/header') %>
<main class="flex-grow max-w-7xl mx-auto px-6 py-12 w-full">
<div class="mb-12 max-w-4xl mx-auto">
<div class="flex items-center justify-between relative">
<div class="absolute left-0 top-1/2 transform -translate-y-1/2 w-full h-[1px] bg-stone-200 dark:bg-stone-700 -z-10"></div>
<div class="flex flex-col items-center bg-background-light dark:bg-background-dark px-4">
<div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center mb-2 shadow-sm">
<span class="material-icons-outlined text-sm">check</span>
</div>
<span class="text-xs font-semibold uppercase tracking-wider text-primary">Shipping</span>
</div>
<div class="flex flex-col items-center bg-background-light dark:bg-background-dark px-4">
<div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center mb-2 shadow-sm">
<span class="material-icons-outlined text-sm">check</span>
</div>
<span class="text-xs font-semibold uppercase tracking-wider text-primary">Payment</span>
</div>
<div class="flex flex-col items-center bg-background-light dark:bg-background-dark px-4">
<div class="w-8 h-8 rounded-full border-2 border-primary bg-background-light dark:bg-surface-dark text-primary flex items-center justify-center mb-2 shadow-sm relative">
<span class="text-sm font-bold">3</span>
</div>
<span class="text-xs font-bold uppercase tracking-wider text-primary">Review</span>
</div>
</div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
<div class="lg:col-span-8 space-y-10">
<h1 class="font-display text-3xl font-bold text-stone-800 dark:text-stone-100 mb-8">Order Review</h1>
<section class="border-b border-stone-200 dark:border-stone-800 pb-8">
    <div class="flex justify-between items-start mb-4">
        <h2 class="font-display text-xl text-stone-700 dark:text-stone-200 flex items-center gap-2">
            Shipping Address
            <span class="material-icons-outlined text-stone-400 text-lg">expand_less</span>
        </h2>
        <a class="text-primary text-sm hover:underline font-medium" href="account.html#addresses">Manage Addresses</a>
    </div>
    <div id="address-list" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Address options will be dynamically inserted here -->
    </div>
</section>
<section class="border-b border-stone-200 dark:border-stone-800 pb-8">
<div class="flex justify-between items-start mb-4">
<h2 class="font-display text-xl text-stone-700 dark:text-stone-200 flex items-center gap-2">
                            Payment Method
                            <span class="material-icons-outlined text-stone-400 text-lg">expand_more</span>
</h2>
<a class="text-primary text-sm hover:underline font-medium" href="#">Edit</a>
</div>
<div class="flex items-center gap-3 text-stone-600 dark:text-stone-400 text-sm">
<span class="material-icons-outlined text-stone-500">credit_card</span>
<p>Visa ending in <span class="font-mono font-medium text-stone-800 dark:text-stone-200">4567</span></p>
</div>
</section>
<section>
    <h2 class="font-display text-xl text-stone-700 dark:text-stone-200 mb-6">Items in Your Order</h2>
    <div id="cart-items" class="space-y-6">
        <!-- Cart items will be dynamically inserted here -->
    </div>
</section>
</div>
<aside class="lg:col-span-4">
<div class="bg-surface-light dark:bg-surface-dark p-8 rounded-xl shadow-lg border border-stone-100 dark:border-stone-800 sticky top-24">
<h2 class="font-display text-2xl font-semibold mb-6 text-stone-800 dark:text-stone-100 border-b border-stone-100 dark:border-stone-700 pb-4">Order Summary</h2>
<div class="space-y-4 mb-8 text-sm">
    <div class="flex justify-between text-stone-600 dark:text-stone-400">
        <span>Subtotal</span>
        <span id="subtotal" class="font-medium text-stone-800 dark:text-stone-200">₹ 0</span>
    </div>
    <div class="flex justify-between text-stone-600 dark:text-stone-400">
        <span>Shipping</span>
        <span class="text-green-600 dark:text-green-400 font-medium">Free</span>
    </div>
    <div class="flex justify-between text-stone-600 dark:text-stone-400">
        <span>Estimated Tax</span>
        <span id="tax" class="font-medium text-stone-800 dark:text-stone-200">₹ 0</span>
    </div>
</div>
<div class="flex justify-between items-end border-t border-stone-100 dark:border-stone-700 pt-6 mb-8">
    <span class="font-display text-lg font-bold text-stone-800 dark:text-stone-100">Total Payable</span>
    <span id="total" class="font-display text-2xl font-bold text-primary">₹ 0</span>
</div>
<button id="place-order-btn" class="w-full bg-primary hover:bg-[#A37D4D] text-white font-medium py-4 px-6 rounded shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2 group">
    <span>Place Order</span>
<span class="material-icons-outlined text-sm opacity-80 group-hover:opacity-100 transition-opacity">lock</span>
</button>
<div class="mt-6 text-xs text-stone-500 dark:text-stone-400 text-center leading-relaxed">
<p>By placing your order, you agree to our <a class="underline hover:text-primary transition-colors" href="#">Terms &amp; Conditions</a> and <a class="underline hover:text-primary transition-colors" href="#">Privacy Policy</a>.</p>
<div class="flex justify-center gap-3 mt-4 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
